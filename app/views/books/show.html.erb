cat << 'EOF' > app/views/books/show.html.erb
<div class="container py-4" style="max-width: 700px;">
  <div class="card shadow-sm border-0 p-4">
    <h1 class="mb-3 text-dark fw-bold"><%= @book.title %></h1>
    
    <p class="text-muted fs-5 mb-4">
      Author: 
      <%= link_to @book.author.name, author_path(@book.author), class: "text-decoration-none fw-semibold text-primary" %>
    </p>

    <hr>

    <div class="row mb-3">
      <div class="col-sm-6">
        <strong>Published Year:</strong> <span class="text-muted"><%= @book.published_year %></span>
      </div>
      <div class="col-sm-6">
        <strong>Price:</strong> <span class="text-success fw-bold fs-5">$<%= @book.price %></span>
      </div>
    </div>

    <% if @book.description.present? %>
      <div class="mb-4">
        <h5 class="fw-bold">Description</h5>
        <p class="text-secondary"><%= @book.description %></p>
      </div>
    <% end %>

    <div class="mt-3">
      <%= link_to "← Back to Books", books_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>
EOF