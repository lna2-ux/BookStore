<div class="container py-4">
  <div class="mb-3">
    <%= link_to "&larr; Back to Books".html_safe, books_path, class: "text-decoration-none text-secondary fw-semibold" %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="row g-4 align-items-center">
      <div class="col-md-3 text-center">
        <%= image_tag "https://covers.openlibrary.org/b/title/#{CGI.escape(@book.title)}-L.jpg", 
            class: "rounded shadow-sm img-fluid", 
            style: "max-height: 250px; object-fit: cover;",
            onerror: "this.onerror=null;this.src='https://via.placeholder.com/150x220?text=No+Cover';" %>
      </div>
      <div class="col-md-9">
        <h1 class="fw-bold text-dark mb-2"><%= @book.title %></h1>
        
        <p class="text-secondary fs-5 mb-3">
          By 
          <% if @book.author.present? %>
            <%= link_to @book.author.name, author_path(@book.author), class: "text-primary text-decoration-none fw-semibold" %>
          <% else %>
            <span class="text-muted">Unknown Author</span>
          <% end %>
        </p>

        <div class="mb-3">
          <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2 fs-5">
            Price: $<%= number_with_precision(@book.price, precision: 2) %>
          </span>
        </div>

        <% if @book.respond_to?(:published_year) && @book.published_year.present? %>
          <p class="text-muted mb-1"><strong>Published Year:</strong> <%= @book.published_year %></p>
        <% end %>

        <% if @book.respond_to?(:description) && @book.description.present? %>
          <div class="mt-4">
            <h5 class="fw-bold">Description</h5>
            <p class="text-secondary"><%= @book.description %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>