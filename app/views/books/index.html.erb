<div class="container py-4">
  <!-- Header with Title and Total Count Badge -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h1 class="fw-bold text-dark mb-1">Book Catalog</h1>
      <p class="text-muted mb-0">Browse our collection or search by title below.</p>
    </div>
    
    <div class="d-flex align-items-center gap-3">
      <span class="badge bg-primary px-3 py-2 fs-6 shadow-sm">
        Total Books: <%= @books.total_count rescue @books.count %>
      </span>
      
      <!-- Top Pagination -->
      <% if respond_to?(:paginate) %>
        <div>
          <%= paginate @books %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Table Card Wrapper -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive mb-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark text-uppercase fs-7 tracking-wider">
          <tr>
            <th scope="col" class="py-3 ps-4" style="width: 10%;">#</th>
            <th scope="col" class="py-3" style="width: 50%;">Book Title</th>
            <th scope="col" class="py-3" style="width: 25%;">Author</th>
            <th scope="col" class="py-3 pe-4" style="width: 15%;">Price</th>
          </tr>
        </thead>
        <tbody>
          <% if @books.any? %>
            <% @books.each_with_index do |book, index| %>
              <tr class="transition-all">
                <th scope="row" class="text-muted ps-4 fw-normal">
                  <%= (params[:page].to_i > 1 ? (params[:page].to_i - 1) * 10 : 0) + index + 1 %>
                </th>
                <td>
                  <%= link_to book.title, book_path(book), class: "text-decoration-none fw-semibold text-primary link-hover" %>
                </td>
                <td>
                  <% if book.author.present? %>
                    <%= link_to book.author.name, author_path(book.author), class: "text-decoration-none text-secondary fw-medium" %>
                  <% else %>
                    <span class="text-muted fst-italic">Unknown Author</span>
                  <% end %>
                </td>
                <td class="pe-4">
                  <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 fs-6">
                    $<%= number_with_precision(book.price, precision: 2) %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center py-5 text-muted">
                <div class="py-4">
                  <h5 class="fw-normal">No books found matching your criteria.</h5>
                  <p class="small text-muted mb-0">Try searching for a different title or clearing your filter.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bottom Pagination -->
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @books %>
  </div>
</div>