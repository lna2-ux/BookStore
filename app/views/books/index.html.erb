<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 fw-bold text-dark">All Books</h1>

  <!-- Search and Filter Form on the Right -->
  <%= form_with url: books_path, method: :get, local: true, class: "d-flex gap-2" do %>
    <%= text_field_tag :search, params[:search], placeholder: "Search book title...", class: "form-control form-control-sm", style: "width: 200px;" %>
    <%= select_tag :author_id, options_from_collection_for_select(@authors, :id, :name, params[:author_id]), include_blank: "All Authors", class: "form-select form-select-sm", style: "width: 180px;" %>
    <%= submit_tag "Filter", class: "btn btn-outline-dark btn-sm" %>
    <%= link_to "Reset", books_path, class: "btn btn-outline-secondary btn-sm" %>
  <% end %>
</div>

<!-- Pagination Top -->
<div class="d-flex justify-content-end mb-3">
  <%= paginate @books %>
</div>

<!-- Books Table -->
<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th scope="col" style="width: 80px;" class="ps-4">#</th>
          <th scope="col">Title</th>
          <th scope="col">Author</th>
          <th scope="col">Published Year</th>
          <th scope="col" class="text-end pe-4">Price</th>
        </tr>
      </thead>
      <tbody>
        <% @books.each_with_index do |book, index| %>
          <tr>
            <th scope="row" class="ps-4 text-muted">
              <%= (params[:page].to_i > 1 ? params[:page].to_i - 1 : 0) * 20 + index + 1 %>
            </th>
            <td>
              <%= link_to book.title, book_path(book), class: "fw-semibold text-decoration-none text-primary" %>
            </td>
            <td>
              <%= link_to book.author.name, author_path(book.author), class: "text-decoration-none text-dark" %>
            </td>
            <td class="text-muted"><%= book.published_year %></td>
            <td class="text-end pe-4 fw-bold text-success">$<%= book.price %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination Bottom -->
<div class="d-flex justify-content-center mt-4">
  <%= paginate @books %>
</div>