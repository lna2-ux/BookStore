<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h1 class="fw-bold text-dark mb-1">Book Catalog</h1>
      <p class="text-muted mb-0">Browse our collection, search by title, or filter by category.</p>
    </div>
    
    <div class="d-flex align-items-center gap-3">
      <span class="badge bg-primary px-3 py-2 fs-6 shadow-sm">
        Total Books: <%= @books.total_count rescue @books.count %>
      </span>
    </div>
  </div>

  <!-- Full-Width Books Table Area (Sidebar removed) -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive mb-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark text-uppercase fs-7 tracking-wider">
          <tr>
            <th scope="col" class="py-3 ps-4" style="width: 8%;">#</th>
            <th scope="col" class="py-3" style="width: 12%;">Image</th>
            <th scope="col" class="py-3" style="width: 35%;">Book Title</th>
            <th scope="col" class="py-3" style="width: 25%;">Author</th>
            <th scope="col" class="py-3" style="width: 15%;">Category</th>
            <th scope="col" class="py-3 pe-4" style="width: 10%;">Price</th>
          </tr>
        </thead>
        <tbody>
          <% if @books.any? %>
            <% @books.each_with_index do |book, index| %>
              <tr>
                <th scope="row" class="text-muted ps-4 fw-normal">
                  <%= (params[:page].to_i > 1 ? (params[:page].to_i - 1) * 10 : 0) + index + 1 %>
                </th>
                <td class="py-2">
                  <img src="https://covers.openlibrary.org/b/id/<%= 100000 + book.id.to_i %>-M.jpg" 
                       class="rounded shadow-sm" 
                       alt="Book Cover" 
                       style="width: 45px; height: 65px; object-fit: cover;"
                       onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&w=45&q=80';">
                </td>
                <td>
                  <%= link_to book.title, book_path(book), class: "text-decoration-none fw-semibold text-primary" %>
                </td>
                <td>
                  <% if book.author.present? %>
                    <%= link_to book.author.name, author_path(book.author), class: "text-decoration-none text-secondary fw-medium" %>
                  <% else %>
                    <span class="text-muted fst-italic">Unknown Author</span>
                  <% end %>
                </td>
                <td>
                  <% if book.category.present? %>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1"><%= book.category.name %></span>
                  <% else %>
                    <span class="text-muted fst-italic">Uncategorized</span>
                  <% end %>
                </td>
                <td class="pe-4">
                  <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 fs-6">
                    $<%= number_with_precision(book.price, precision: 2) %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <div class="py-4">
                  <h5 class="fw-normal">No books found matching your criteria.</h5>
                  <p class="small text-muted mb-0">Try selecting a different category or clearing your search.</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <div class="d-flex justify-content-center mt-4">
    <%= paginate @books if respond_to?(:paginate) %>
  </div>
</div>