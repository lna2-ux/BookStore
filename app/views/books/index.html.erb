<div class="container py-4">
  <h1 class="mb-4">All Authors</h1>

  <div class="list-group shadow-sm">
    <% @authors.each do |author| %>
      <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
        <div>
          <h5 class="mb-1">
            <%= link_to author.name, author_path(author), class: "text-decoration-none fw-semibold" %>
          </h5>
          <p class="text-muted mb-0 small"><%= truncate(author.bio, length: 120) %></p>
        </div>
        <span class="badge bg-secondary rounded-pill"><%= author.books.count %> books</span>
      </div>
    <% end %>
  </div>
</div>