<div class="container py-5">
  <!-- Page Header Banner Area -->
  <div class="text-center bg-light py-5 mb-5 rounded-4 shadow-sm">
    <h1 class="fw-bold text-dark display-5 mb-2">Authors</h1>
    <p class="text-muted mb-0">
      <span class="text-secondary">Home</span> <span class="mx-2">&gt;</span> <span class="text-dark fw-semibold">Authors</span>
    </p>
  </div>

  <div class="row">
    <!-- Main Authors Grid (3 columns of circular avatars) -->
    <div class="col-lg-9">
      <div class="row g-4">
        <% @authors.each_with_index do |author, index| %>
          <div class="col-md-4 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white hover-shadow transition">
              <div class="d-flex justify-content-center mb-3">
                <!-- Circular Author Portrait Image -->
                <img src="https://picsum.photos/seed/author<%= author.id %>-<%= index %>/200/200" 
                     class="rounded-circle shadow-sm border border-3 border-light bg-secondary object-fit-cover" 
                     alt="<%= author.name %>" 
                     style="width: 120px; height: 120px;">
              </div>
              <h5 class="fw-bold text-dark mb-1">
                <%= link_to author.name, author_path(author), class: "text-decoration-none text-dark stretched-link" %>
              </h5>
              <p class="text-muted small mb-0">
                <%= author.books.count %> <%= author.books.count == 1 ? 'book' : 'books' %>
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pagination -->
      <div class="d-flex justify-content-center mt-5">
        <%= paginate @authors if respond_to?(:paginate) %>
      </div>
    </div>

    <!-- Right Sidebar (Search and Categories) -->
    <div class="col-lg-3 mt-4 mt-lg-0">
      <!-- Search Box -->
      <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <h6 class="fw-bold text-dark mb-3">Search</h6>
        <form action="<%= authors_path %>" method="get">
          <div class="input-group">
            <input type="text" name="query" class="form-control form-control-sm" placeholder="Enter Keyword..." value="<%= params[:query] %>">
            <button class="btn btn-outline-secondary btn-sm" type="submit">🔍</button>
          </div>
        </form>
      </div>

      <!-- Categories Widget -->
      <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <h6 class="fw-bold text-dark mb-3">Categories</h6>
        <ul class="list-unstyled mb-0 small text-secondary">
          <% if defined?(@categories) && @categories.present? %>
            <% @categories.each do |cat| %>
              <li class="d-flex justify-content-between py-1 border-bottom">
                <%= link_to cat.name, books_path(category_id: cat.id), class: "text-decoration-none text-secondary" %>
                <span class="text-muted">(<%= Book.where(category_id: cat.id).count %>)</span>
              </li>
            <% end %>
          <% else %>
            <li class="py-1 text-muted">No categories available</li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>