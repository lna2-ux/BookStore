<div class="container py-4">
  <h1 class="mb-2"><%= @author.name %></h1>
  <p class="lead text-muted"><%= @author.bio %></p>

  <hr class="my-4">

  <h3 class="mb-3">Books by <%= @author.name %></h3>
  
  <% if @author.books.any? %>
    <div class="list-group mb-4 shadow-sm">
      <% @author.books.each do |book| %>
        <div class="list-group-item d-flex justify-content-between align-items-center p-3">
          <div>
            <%= link_to book.title, book_path(book), class: "fw-bold text-decoration-none text-primary" %>
            <small class="text-muted ms-2">(Published: <%= book.published_year %>)</small>
          </div>
          <span class="text-success fw-bold">$<%= book.price %></span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-muted">No books currently listed for this author.</p>
  <% end %>

  <%= link_to "← Back to Authors", authors_path, class: "btn btn-outline-secondary mt-3" %>
</div>
