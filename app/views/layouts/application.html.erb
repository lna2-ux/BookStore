<!DOCTYPE html>
<html>
  <head>
    <title>BookStore</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Dark Navbar matching your reference -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-4 mb-4 shadow-sm">
      <div class="container-fluid">
        <%= link_to "BookStore", root_path, class: "navbar-brand fw-bold" %>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%= link_to "Books", books_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "Authors", authors_path, class: "nav-link" %>
            </li>
            <li class="nav-item">
              <%= link_to "About", about_path, class: "nav-link" %>
            </li>
          </ul>

          <!-- Search Form on the right -->
          <%= form_with url: books_path, method: :get, local: true, class: "d-flex" do |f| %>
            <%= f.text_field :search, value: params[:search], placeholder: "Book Search", class: "form-control me-2", style: "width: 220px;" %>
            <%= f.submit "Search", class: "btn btn-outline-success" %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>